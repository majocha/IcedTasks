<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net11.0</TargetFrameworks>
  </PropertyGroup>
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Optimize>true</Optimize>
    <Configuration>Release</Configuration>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Consts.fs" />
    <Compile Include="SynchonousCompletionBenchmark.fs" />
    <Compile Include="AsynchonousCompletionBenchmark.fs" />
    <Compile Include="FileWritingBenchmarks.fs" />
    <Compile Include="ParallelAsyncBenchmarks.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\IcedTasks.11\IcedTasks.11.fsproj" />
    <ProjectReference Include="..\CSharpTaskBenchmarks\CSharpTaskBenchmarks.csproj" />
  </ItemGroup>
    <ItemGroup>
        <PackageReference Include="FSharp.Core" VersionOverride="7.0.400" ExcludeAssets="all" PrivateAssets="all" />
        <Reference Include="FSharp.Core">
            <HintPath>$(RuntimeAsyncBitsPath)\FSharp.Core\Release\net10.0\FSharp.Core.dll</HintPath>
        </Reference>
    </ItemGroup>
  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <PackageReference Include="Ply" />
  </ItemGroup>
</Project>